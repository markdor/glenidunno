{
	"name": "glenidunno",
	"private": true,
	"description": "Selbst gehostete Web-App (PWA) mit Magic-Link-Login, Nutzerverwaltung und Startseite.",
	"license": "AGPL-3.0-only",
	"author": "markdor",
	"engines": {
		"node": ">=24"
	},
	"version": "1.6.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test:coverage": "vitest run --coverage",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test",
		"docker:build": "docker build -t glenidunno:local .",
		"docker:dev": "docker compose up --build",
		"docker:test": "playwright test --config=playwright.docker.config.ts",
		"db:generate": "drizzle-kit generate",
		"db:seed": "node scripts/seed-test-tasting.ts",
		"db:reset": "node scripts/reset-local-dev.ts",
		"dev:init": "npm run db:reset && npm run db:seed && npm run dev"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^24.19.0",
		"@types/nodemailer": "^8.0.1",
		"@vitest/browser-playwright": "^4.1.11",
		"@vitest/coverage-v8": "^4.1.11",
		"dotenv": "^17.4.2",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.13.0",
		"playwright": "^1.61.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.0",
		"vite": "^8.3.2",
		"vitest": "^4.1.9",
		"vitest-browser-svelte": "^2.2.1"
	},
	"dependencies": {
		"@lucide/svelte": "^1.49.0",
		"better-auth": "^1.7.7",
		"better-sqlite3": "^12.11.1",
		"drizzle-orm": "^0.45.3",
		"nodemailer": "^8.0.11",
		"pino": "^10.3.1",
		"pino-pretty": "^13.1.3"
	}
}
