{
	"name": "glenidunno",
	"private": true,
	"description": "Selbst gehostete Web-App (PWA) mit Magic-Link-Login, Nutzerverwaltung und Startseite.",
	"license": "AGPL-3.0-only",
	"author": "markdor",
	"engines": {
		"node": ">=24"
	},
	"version": "1.12.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test:coverage": "vitest run --coverage",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test",
		"docker:build": "docker build -t glenidunno:local .",
		"docker:dev": "docker compose up --build",
		"docker:test": "playwright test --config=playwright.docker.config.ts",
		"db:generate": "drizzle-kit generate",
		"db:seed": "node scripts/seed-test-tasting.ts",
		"db:reset": "node scripts/reset-local-dev.ts",
		"db:import-history": "node scripts/import-history.ts",
		"map:build": "node scripts/build-map-geometry.ts",
		"dev:init": "npm run db:reset && npm run db:seed && npm run dev"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/better-sqlite3": "^7.6.13",
		"@types/d3-geo": "^3.1.1",
		"@types/node": "^24.19.2",
		"@types/nodemailer": "^8.0.1",
		"@types/topojson-client": "^3.1.5",
		"@vitest/browser-playwright": "^4.1.11",
		"@vitest/coverage-v8": "^4.1.11",
		"d3-geo": "^3.1.1",
		"dotenv": "^17.4.2",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"pdfjs-dist": "^6.4.299",
		"playwright": "^1.61.0",
		"polygon-clipping": "^0.15.7",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.1",
		"topojson-client": "^3.1.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.2",
		"vite": "^8.3.4",
		"vitest": "^4.1.9",
		"vitest-browser-svelte": "^2.2.1",
		"world-atlas": "^2.0.2"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.135.0",
		"@lucide/svelte": "^1.53.0",
		"better-auth": "^1.7.7",
		"better-sqlite3": "^12.11.1",
		"drizzle-orm": "^0.45.4",
		"nodemailer": "^8.0.11",
		"pino": "^10.4.0",
		"pino-pretty": "^13.2.0"
	}
}
