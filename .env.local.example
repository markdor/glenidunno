# Copy to .env.local and adjust. Vite picks this up automatically for
# `npm run dev` and gives it precedence over .env.
BASE_URL=http://localhost:5173

# Local SQLite file. Kept out of /data because there's no named volume
# during plain `npm run dev`.
DB_PATH=./glenidunno.db

# Presentation uploads of the whisky tastings, next to the local DB.
MEDIA_PATH=./media

# Optional: Gotenberg for viewing office presentations in the app. Without it
# original PDFs stay viewable and office files show the viewer's error state.
# Start one with: docker run --rm -p 3001:3000 gotenberg/gotenberg:8.37.0-libreoffice
# GOTENBERG_URL=http://localhost:3001