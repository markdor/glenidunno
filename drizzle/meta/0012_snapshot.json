			"checkConstraints": {
				"distillery_country_state": {
					"name": "distillery_country_state",
					"value": "\"distillery\".\"country_state\" IN ('pending', 'found', 'admin', 'empty')"
				},
				"distillery_country_value_state": {
					"name": "distillery_country_value_state",
					"value": "(\"distillery\".\"country\" IS NOT NULL) = (\"distillery\".\"country_state\" IN ('found', 'admin'))"
				},
				"distillery_country_source_state": {
					"name": "distillery_country_source_state",
					"value": "(\"distillery\".\"country_source\" IS NULL AND \"distillery\".\"country_rules\" IS NULL) OR \"distillery\".\"country_state\" = 'found'"
				},
				"distillery_country_source_length": {
					"name": "distillery_country_source_length",
					"value": "length(\"distillery\".\"country_source\") BETWEEN 1 AND 2048"
				},
				"distillery_region_state": {
					"name": "distillery_region_state",
					"value": "\"distillery\".\"region_state\" IN ('pending', 'found', 'admin', 'empty')"
				},
				"distillery_region_value_state": {
					"name": "distillery_region_value_state",
					"value": "(\"distillery\".\"region\" IS NOT NULL) = (\"distillery\".\"region_state\" IN ('found', 'admin'))"
				},
				"distillery_region_source_state": {
					"name": "distillery_region_source_state",
					"value": "(\"distillery\".\"region_source\" IS NULL AND \"distillery\".\"region_rules\" IS NULL) OR \"distillery\".\"region_state\" = 'found'"
				},
				"distillery_region_source_length": {
					"name": "distillery_region_source_length",
					"value": "length(\"distillery\".\"region_source\") BETWEEN 1 AND 2048"
				},
				"distillery_capacity_state": {
					"name": "distillery_capacity_state",
					"value": "\"distillery\".\"capacity_state\" IN ('pending', 'found', 'admin', 'empty')"
				},
				"distillery_capacity_value_state": {
					"name": "distillery_capacity_value_state",
					"value": "(\"distillery\".\"capacity\" IS NOT NULL) = (\"distillery\".\"capacity_state\" IN ('found', 'admin'))"
				},
				"distillery_capacity_source_state": {
					"name": "distillery_capacity_source_state",
					"value": "(\"distillery\".\"capacity_source\" IS NULL AND \"distillery\".\"capacity_rules\" IS NULL) OR \"distillery\".\"capacity_state\" = 'found'"
				},
				"distillery_capacity_source_length": {
					"name": "distillery_capacity_source_length",
					"value": "length(\"distillery\".\"capacity_source\") BETWEEN 1 AND 2048"
				},
				"distillery_country_length": {
					"name": "distillery_country_length",
					"value": "length(\"distillery\".\"country\") BETWEEN 1 AND 60"
				},
				"distillery_region_list": {
					"name": "distillery_region_list",
					"value": "\"distillery\".\"region\" IN ('Islay', 'Campbeltown', 'Inseln', 'Speyside', 'Highlands', 'Lowlands')"
				},
				"distillery_region_country": {
					"name": "distillery_region_country",
					"value": "\"distillery\".\"region\" IS NULL OR \"distillery\".\"country\" = 'Schottland'"
				},
				"distillery_capacity_range": {
